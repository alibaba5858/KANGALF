rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'balance', 'factories', 'warehouse']) &&
             data.uid is string &&
             data.displayName is string && data.displayName.size() < 50 &&
             data.balance is number &&
             data.factories is map &&
             data.warehouse is map;
    }

    match /users/{userId} {
      // Allow everyone to read the leaderboard (listing users)
      // but only owners can update their own data
      allow read: if true; 
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
    }
  }
}
